import numpy as np

# import sys
# sys.path.append(r"/path/to/artchart/src/")
import artchart.artchart as ac
from artchart.kompas_bridge import KompasBridge_v7
import artchart.colors as colors

# Мост (bridge) между API Компаса и библиоткой artchart
bridge7 = KompasBridge_v7(
    kompas_api7_module,
    kompas6_constants,
    kompas_document_2d
)

# Создание графика (инициализация)
ch1 = ac.Chart(
    bridge7,            # Мост
    step = (1, 0.2),    # Шаг штрихов (ticks) по оси X и Y
    xlims = (-7, 7),    # Минимальное и максимальное значение по оси X
    ylims = (-2, 2),    # Минимальное и максимальное значение по оси Y
    rdim = (500, 250),  # Реальные размеры графика на
                        # листе (ширина, высота) на чертеже в мм
    axprec = (1, 1),    # Количество знаков после запятой у штрихов
    view_name = "График Функции sin(x)"    # Название вида графика
)
# Задний фон графика (сетка + рамка графика)
ch1.background()

# Массивы точек графика
X_arr = np.linspace(-6, 6, num = 100)
Y1_arr = np.sin(X_arr)

# Построение линии графика
ch1.plot(
    X_arr,                  # Точки по оси X
    Y1_arr,                 # Точки по оси Y
    "line1",                # Название слоя и макроэлемента линии
    color = colors.RED      # Цвет линии
)
